{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agents",
  "version": "0.0.1",
  "identifier": "dev.majke.agents",
  "build": {
    "devUrl": "http://localhost:5183",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      { "title": "Agents", "width": 1400, "height": 900, "minWidth": 640, "minHeight": 400, "decorations": false, "transparent": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"],
    "category": "Development"
  }
}
