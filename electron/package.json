{
  "name": "roost-app",
  "version": "0.0.2",
  "license": "GPL-3.0-or-later",
  "author": "majke",
  "private": true,
  "main": "out/main.cjs",
  "scripts": {
    "build:web": "node ../node_modules/vite/bin/vite.js build .. --base ./ --outDir electron/dist-web --emptyOutDir",
    "build:main": "node ../node_modules/vite/bin/vite.js build",
    "build": "npm run build:web && npm run build:main",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && rm -rf node_modules/node-pty/build && CXXFLAGS=\"-include '$PWD/build-tools/glibc-compat.h'\" electron-builder --linux AppImage --publish never && ./build-tools/check-pty-glibc.sh",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "Roost",
  "description": "Roost – rule the roost",
  "desktopName": "roost-app.desktop",
  "build": {
    "toolsets": {
      "appimage": "1.0.3"
    },
    "appId": "dev.majke.roost",
    "productName": "Roost",
    "publish": {
      "provider": "github",
      "owner": "tonieMajke",
      "repo": "roost"
    },
    "directories": {
      "output": "release"
    },
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "files": [
      "out/**",
      "dist-web/**",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "../branding/icon.png",
      "category": "Development",
      "executableName": "roost-app",
      "artifactName": "Roost-${version}.AppImage",
      "desktop": {
        "entry": {
          "StartupWMClass": "roost-app"
        }
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "files": [
        "!node_modules/node-pty/build/deps/**",
        "!node_modules/node-pty/build/Release/obj/**",
        "!node_modules/node-pty/build/**/*.{tlog,obj,pdb,lib,iobj,ipdb,exp,ilk,vcxproj,filters,recipe,sln}",
        "!node_modules/node-pty/prebuilds/darwin-*/**",
        "!node_modules/node-pty/prebuilds/win32-arm64/**",
        "!node_modules/node-pty/third_party/conpty/*/win10-arm64/**"
      ],
      "icon": "../branding/icon.png",
      "executableName": "Roost",
      "artifactName": "Roost-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Roost-Setup-${version}.${ext}"
    }
  }
}
